# ===========================================
#  MedVision-RAG 环境变量配置模板
#  复制本文件为 .env 并填入你自己的值
#  cp .env.example .env
# ===========================================

# 1. 数据库配置 (Database)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=medvision

# 2. AI 服务配置 (AI Services)
#    DeepSeek: https://platform.deepseek.com/api_keys
#    Groq:     https://console.groq.com/keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# 3. 邮件通知配置 (Email Alerts) — 可选，不配则风险预警邮件功能不生效
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_RECEIVER=receiver@example.com

# 4. 内部服务鉴权 (Internal Service Auth)
INTERNAL_TOKEN=change-me-to-a-random-string
